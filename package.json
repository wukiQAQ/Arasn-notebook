{
  "name": "arasn-notebook",
  "version": "0.4.0",
  "private": true,
  "description": "A quick office whiteboard with local network sharing",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/server.test.cjs",
    "test:ui": "playwright test",
    "pack": "npm run build && node scripts/pack.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs"
  },
  "dependencies": {
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
